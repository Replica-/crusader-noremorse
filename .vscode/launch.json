{
    "version": "0.2.0",
    "configurations": [
        // The normal game: intro movies, main menu, saved games; no mission shortcut.
        {
            "name": "🔨🎮 Game: Build & Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build",
            "presentation": { "group": "0 Game", "order": 1 }
        },
        {
            "name": "🎮 Game: Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "presentation": { "group": "0 Game", "order": 2 }
        },
        {
            "name": "🔨▶️  Mission 1: Build & Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build",
            "presentation": { "group": "1 Mission 1", "order": 1 }
        },
        {
            "name": "▶️  Mission 1: Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "presentation": { "group": "1 Mission 1", "order": 2 }
        },
        // Mission 2 is map 3 of the game's data; --all-items gives every weapon, its ammunition and every inventory item
        // (what the slots do not hold lies at the start).
        {
            "name": "🔨▶️  Mission 2 (all weapons & items): Build & Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--mission", "3", "--all-items"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build",
            "presentation": { "group": "2 Mission 2", "order": 1 }
        },
        {
            "name": "▶️  Mission 2 (all weapons & items): Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--mission", "3", "--all-items"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "presentation": { "group": "2 Mission 2", "order": 2 }
        },
        // The lighting with its debug mode on: the rooms the lights light are tinted, a left click on a light shows its own
        // room; F7 turns the debug mode off and on again.
        {
            "name": "🔨💡 Light debug (Mission 1): Build & Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--lighting", "--light-debug"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build",
            "presentation": { "group": "4 Lighting", "order": 1 }
        },
        {
            "name": "💡 Light debug (Mission 1): Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--lighting", "--light-debug"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "presentation": { "group": "4 Lighting", "order": 2 }
        },
        // The rooms as the lighting sees them: the room you are in; a left
        // click on a floor shows that floor's room, on a light the room it lights. F7 turns the debug view off and on.
        {
            "name": "🔨🧱 Room debug (Mission 1): Build & Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--lighting", "--room-debug"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build",
            "presentation": { "group": "4 Lighting", "order": 3 }
        },
        {
            "name": "🧱 Room debug (Mission 1): Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--lighting", "--room-debug"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "presentation": { "group": "4 Lighting", "order": 4 }
        },
        // The light editor: the world frozen and all of it shown. WASD pan, the wheel zooms, Page Up / Down change maps;
        // left click places or selects a light, right click removes it, T makes the sprite under the pointer light or not.
        // Saved at once into assets/lights/map_NNN.cfg (commit them). Change "--mission" to start on another map.
        {
            "name": "🔨💡 Light editor: Build & Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--mission", "1", "--light-editor"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build",
            "presentation": { "group": "4 Lighting", "order": 5 }
        },
        {
            "name": "💡 Light editor: Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/crusader.exe",
            "args": ["tools/release", "--new-game", "--skip-movies", "--keyboard-mouse", "--mission", "1", "--light-editor"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "D:/development/msys64/ucrt64/bin;${env:PATH}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/ucrt64/bin/gdb.exe",
            "presentation": { "group": "4 Lighting", "order": 6 }
        },
        {
            "name": "🎥 Record: Mission 1 (screen + game audio)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/record-crusader.ps1\"",
            "cwd": "${workspaceFolder}",
            "presentation": { "group": "3 Recording", "order": 1 }
        }
    ]
}
